# Velora backend environment variables.
# Copy to .env for local dev, or set these in your Render dashboard
# for production. Every variable below is genuinely read by the code.

# ---- Security-critical: set these to real values before any real deployment ----

# Secret used to sign and verify auth tokens (JWT). Generate a long
# random string (e.g. `openssl rand -hex 32`). If unset, auth cannot
# issue or verify tokens and every authenticated route will reject.
JWT_SECRET_KEY=

# Comma-separated list of browser origins allowed to call this API.
# Set to your real frontend domain(s) in production. If unset, it
# defaults to localhost dev origins only - never a wildcard.
# Example: https://velora.app,https://www.velora.app
VELORA_ALLOWED_ORIGINS=

# ---- Database ----

# Postgres connection string (Supabase in this project).
DATABASE_URL=

# ---- External APIs ----

# Anthropic API key - powers all AI features (drafting, research,
# roadmap generation, chat, etc.).
ANTHROPIC_API_KEY=

# Voyage AI key - listing/profile semantic embeddings. If unset, the
# semantic-match factor is skipped gracefully (see embeddings.py).
VOYAGE_API_KEY=

# Adzuna job-listings API credentials.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Resend - transactional email (outreach/engagement send).
RESEND_API_KEY=
# The From address used when sending email via Resend.
SEND_FROM_ADDRESS=

# ---- App configuration (optional; sensible defaults in code) ----

# Public base URL of the app, used to build links in emails
# (e.g. the engagement accept link).
APP_BASE_URL=

# How often the background scan cycle runs, in minutes.
SCAN_INTERVAL_MINUTES=

# Default auto-apply confidence threshold (a new profile's starting value).
AUTO_APPLY_THRESHOLD=

# Minutes an auto-approved application waits before it can be sent
# (the undo window).
UNDO_WINDOW_MINUTES=
